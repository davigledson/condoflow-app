<%# app/views/layouts/_navbar.html.erb %>

<%# BOTÃO HAMBURGER - fora do aside para não sumir com ele %>
<button id="sidebar-toggle"
  class="md:hidden fixed top-4 left-4 z-50 bg-white dark:bg-gray-800
         border border-gray-200 dark:border-gray-700 rounded-lg p-2 shadow cursor-pointer">
  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
  </svg>
</button>

<%# OVERLAY %>
<div id="sidebar-overlay"
  class="fixed inset-0 bg-black/40 hidden md:hidden z-30"></div>

<%# SIDEBAR %>
<aside id="sidebar"
  class="fixed top-0 left-0 h-screen w-56 bg-white dark:bg-gray-900
         border-r border-gray-200 dark:border-gray-700 flex flex-col z-40
         -translate-x-full md:translate-x-0 transition-transform duration-300">

  <%= link_to root_path, class: "flex items-center justify-center py-6 px-4 border-b border-gray-100 dark:border-gray-700" do %>
    <%= image_tag "logo.png", style: "height: 6.5rem; object-fit: contain;" %>
  <% end %>

  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">

    <%= link_to tickets_path,
          class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{request.path.start_with?('/tickets') ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      Chamados
    <% end %>

    <% if current_user&.admin? %>

      <%= link_to blocks_path,
            class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{request.path.start_with?('/blocks') ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
        Blocos
      <% end %>

      <%= link_to users_path,
            class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{request.path.start_with?('/users') ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Usuários
      <% end %>

      <%= link_to ticket_types_path,
            class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{request.path.start_with?('/ticket_types') ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/>
        </svg>
        Tipos de Chamado
      <% end %>

      <%= link_to ticket_statuses_path,
            class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{request.path.start_with?('/ticket_statuses') ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Status
      <% end %>

    <% end %>
    <%= link_to admin_auditoria_path,
      class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{request.path.start_with?('/admin/auditoria') ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
  </svg>
  Auditoria
<% end %>
  </nav>

  <div class="border-t border-gray-100 dark:border-gray-700 px-4 py-4 space-y-2">

    <button id="theme-toggle"
            class="w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200 transition-colors">
      <svg id="icon-light" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
      </svg>
      <svg id="icon-dark" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
      </svg>
      <span id="theme-label">Modo escuro</span>
    </button>

    <% if logged_in? %>
      <div class="flex items-center gap-3 pt-1">
        <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 flex items-center justify-center text-xs font-semibold shrink-0">
          <%= current_user.name[0].upcase %>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-medium text-gray-800 dark:text-gray-100 truncate"><%= current_user.name %></p>
          <p class="text-xs text-gray-400 dark:text-gray-500"><%= current_user.role %></p>
        </div>
      </div>
      <%= button_to logout_path, method: :delete,
            class: "w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-950 hover:text-red-600 transition-colors" do %>
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Sair
      <% end %>
    <% end %>
  </div>

</aside>

<%# SCRIPTS - tema e sidebar %>
<%# SCRIPTS - tema e sidebar %>
<script>
  function applyTheme(dark) {
    const iconLight = document.getElementById('icon-light');
    const iconDark  = document.getElementById('icon-dark');
    const label     = document.getElementById('theme-label');
    if (!iconLight || !iconDark || !label) return;
    if (dark) {
      document.documentElement.classList.add('dark');
      iconLight.classList.add('hidden');
      iconDark.classList.remove('hidden');
      label.textContent = 'Modo claro';
    } else {
      document.documentElement.classList.remove('dark');
      iconLight.classList.remove('hidden');
      iconDark.classList.add('hidden');
      label.textContent = 'Modo escuro';
    }
  }

  function initTheme() {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;
    applyTheme(document.documentElement.classList.contains('dark'));
    toggleBtn.replaceWith(toggleBtn.cloneNode(true));
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      applyTheme(!isDark);
      localStorage.setItem('theme', !isDark ? 'dark' : 'light');
    });
  }

  function initSidebar() {
    const sidebar = document.getElementById("sidebar");
    const toggle  = document.getElementById("sidebar-toggle");
    const overlay = document.getElementById("sidebar-overlay");
    if (!sidebar || !toggle || !overlay) return;

    function openSidebar() {
      sidebar.classList.remove("-translate-x-full");
      overlay.classList.remove("hidden");
    }

    function closeSidebar() {
      sidebar.classList.add("-translate-x-full");
      overlay.classList.add("hidden");
    }

    function toggleSidebar() {
      const isOpen = !sidebar.classList.contains("-translate-x-full");
      isOpen ? closeSidebar() : openSidebar();
    }

    const newToggle = toggle.cloneNode(true);
    const newOverlay = overlay.cloneNode(true);
    toggle.replaceWith(newToggle);
    overlay.replaceWith(newOverlay);

    document.getElementById("sidebar-toggle").addEventListener("click", toggleSidebar);
    document.getElementById("sidebar-overlay").addEventListener("click", closeSidebar);
  }

  document.addEventListener('turbo:load', () => {
    initTheme();
    initSidebar();
  });
</script>