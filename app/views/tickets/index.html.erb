<%# app/views/tickets/index.html.erb %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-100">Chamados</h1>
  <% if current_user.resident? %>
    <%= link_to "Novo Chamado", new_ticket_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700" %>
  <% end %>
</div>

<%# Escopo de tickets baseado no papel do usuário (mesmo do controller) %>
<%
  scoped = if current_user.admin?
             Ticket.all
           elsif current_user.collaborator?
             Ticket.where(ticket_type: current_user.assigned_ticket_types)
           else
             Ticket.where(unit: current_user.units)
           end
%>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <!-- Card 1: Total de chamados -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Total de Chamados</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1"><%= scoped.count %></p>
      </div>
      <div class="rounded-full bg-indigo-50 dark:bg-indigo-900/30 p-3 text-indigo-500 dark:text-indigo-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 2: Chamados abertos (status não final) -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Abertos</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1">
          <%= scoped.joins(:ticket_status).where(ticket_statuses: { is_final: false }).count %>
        </p>
      </div>
      <div class="rounded-full bg-blue-50 dark:bg-blue-900/30 p-3 text-blue-500 dark:text-blue-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 3: Chamados concluídos (status final) -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Concluídos</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1">
          <%= scoped.joins(:ticket_status).where(ticket_statuses: { is_final: true }).count %>
        </p>
      </div>
      <div class="rounded-full bg-green-50 dark:bg-green-900/30 p-3 text-green-500 dark:text-green-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 4: Chamados com SLA vencido (apenas para admin/colaborador) -->
  <% if current_user.admin? || current_user.collaborator? %>
    <%
      # Calcula chamados não finalizados cujo tempo de criação + SLA já passou da data atual
      overdue = scoped
                .joins(:ticket_type, :ticket_status)
                .where(ticket_statuses: { is_final: false })
                .where("tickets.created_at + (ticket_types.sla_hours || ' hour')::interval < NOW()")
                .count
    %>
    <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Atrasados (SLA)</p>
          <p class="text-3xl font-extrabold text-red-600 dark:text-red-400 mt-1"><%= overdue %></p>
        </div>
        <div class="rounded-full bg-red-50 dark:bg-red-900/30 p-3 text-red-500 dark:text-red-400">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
    </div>
  <% else %>
    <%# Para moradores, exibe "Meus Abertos" %>
    <% my_open = scoped.joins(:ticket_status).where(ticket_statuses: { is_final: false }).count %>
    <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Meus Abertos</p>
          <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1"><%= my_open %></p>
        </div>
        <div class="rounded-full bg-amber-50 dark:bg-amber-900/30 p-3 text-amber-500 dark:text-amber-400">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if current_user.admin? || current_user.collaborator? %>
  <%= form_with url: tickets_path, method: :get, local: true, class: "flex gap-3 mb-6 flex-wrap" do |f| %>
    <%= f.select :status_id,
          options_from_collection_for_select(TicketStatus.all, :id, :name, params[:status_id]),
          { include_blank: "Todos os status" },
          class: "border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100",
          style: "color-scheme: light",
          data: { dark_style: "color-scheme: dark" } %>

    <%= f.select :type_id,
          options_from_collection_for_select(TicketType.all, :id, :title, params[:type_id]),
          { include_blank: "Todos os tipos" },
          class: "border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100" %>

    <%= f.select :block_id,
          options_from_collection_for_select(Block.all, :id, :identifier, params[:block_id]),
          { include_blank: "Todos os blocos" },
          class: "border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100" %>

    <%= f.submit "Filtrar", class: "bg-gray-700 dark:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800 cursor-pointer" %>
    <%= link_to "Limpar", tickets_path, class: "text-sm text-gray-500 dark:text-gray-400 hover:underline self-center" %>
  <% end %>
<% end %>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
  <% if @tickets.empty? %>
    <p class="text-center text-gray-400 dark:text-gray-500 py-12 text-sm">Nenhum chamado encontrado.</p>
  <% else %>
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 text-left">
        <tr>
          <th class="px-4 py-3">#</th>
          <th class="px-4 py-3">Unidade</th>
          <th class="px-4 py-3">Tipo</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Aberto em</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        <% @tickets.each do |ticket| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-4 py-3 text-gray-400 dark:text-gray-500">#<%= ticket.id %></td>
            <td class="px-4 py-3 font-medium text-gray-700 dark:text-gray-200"><%= ticket.unit.identifier %></td>
            <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= ticket.ticket_type.title %></td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-900 text-blue-700 dark:text-blue-300">
                <%= ticket.ticket_status.name %>
              </span>
            </td>
            <td class="px-4 py-3 text-gray-400 dark:text-gray-500"><%= ticket.created_at.strftime("%d/%m/%Y %H:%M") %></td>
            <td class="px-4 py-3">
              <%= link_to "Ver", ticket_path(ticket), class: "text-blue-500 dark:text-blue-400 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<%= render "layouts/pagination", paginator: @tickets %>