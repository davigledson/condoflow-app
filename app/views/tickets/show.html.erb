<%# app/views/tickets/show.html.erb %>
<div class="max-w-2xl mx-auto space-y-6">

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">Chamado #<%= @ticket.id %></p>
        <h1 class="text-lg font-semibold text-gray-800 dark:text-gray-100"><%= @ticket.ticket_type.title %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Unidade <%= @ticket.unit.identifier %> &mdash; <%= @ticket.user.name %></p>
      </div>
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300">
        <%= @ticket.ticket_status.name %>
      </span>
    </div>

    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed"><%= @ticket.description %></p>

    <div class="mt-4 text-xs text-gray-400 dark:text-gray-500">
      Aberto em <%= @ticket.created_at.strftime("%d/%m/%Y às %H:%M") %>
      <% if @ticket.closed_at %>
        &mdash; Concluído em <%= @ticket.closed_at.strftime("%d/%m/%Y às %H:%M") %>
      <% end %>
    </div>
  </div>

  <% if current_user.admin? || current_user.collaborator? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Atualizar Status</h2>
      <%= form_with url: update_status_ticket_path(@ticket), method: :patch, local: true, class: "flex gap-3" do |f| %>
        <%= f.select :ticket_status_id,
              options_from_collection_for_select(TicketStatus.all, :id, :name, @ticket.ticket_status_id),
              {},
              class: "border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-sm flex-1 bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-100" %>
        <%= f.submit "Atualizar", class: "bg-gray-700 dark:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800 cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
<% if @ticket.attachments.attached? %>
  <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
    <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-2">Anexos</p>
    <div class="flex flex-wrap gap-3">
      <% @ticket.attachments.each do |attachment| %>
        <div class="relative group w-32">
          <% if attachment.image? %>
            <%= link_to rails_blob_path(attachment, disposition: "inline"), target: "_blank", class: "block" do %>
              <%= image_tag attachment.variant(resize_to_limit: [200, 200]),
                    class: "w-full h-32 object-cover rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 hover:opacity-90 transition",
                    alt: attachment.filename %>
              <div class="absolute inset-0 bg-opacity-0 group-hover:bg-opacity-20 rounded-lg transition"></div>
            <% end %>
          <% else %>
            <%= link_to rails_blob_path(attachment, disposition: "attachment"),
                  class: "flex flex-col items-center justify-center h-32 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-100 transition" do %>
              <svg class="w-8 h-8 text-gray-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
              </svg>
              <span class="text-xs text-gray-600 dark:text-gray-400 truncate w-full px-2 text-center"><%= attachment.filename %></span>
              <span class="text-xs text-gray-400"><%= number_to_human_size(attachment.byte_size) %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
  <% if @ticket.ticket_status_histories.any? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Histórico de Status</h2>
      <ul class="space-y-2">
        <% @ticket.ticket_status_histories.includes(:ticket_status, :user).order(created_at: :asc).each do |h| %>
          <li class="text-xs text-gray-500 dark:text-gray-400">
            <span class="font-medium text-gray-700 dark:text-gray-200"><%= h.user.name %></span>
            alterou para
            <span class="font-medium text-gray-700 dark:text-gray-200"><%= h.ticket_status.name %></span>
            em <%= h.created_at.strftime("%d/%m/%Y %H:%M") %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">Comentários</h2>

    <% if @comments.empty? %>
      <p class="text-sm text-gray-400 dark:text-gray-500 mb-4">Nenhum comentário ainda.</p>
    <% else %>
      <ul class="space-y-4 mb-6">
        <% @comments.each do |comment| %>
  <li class="flex gap-3">
    <div class="w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-xs font-medium text-gray-600 dark:text-gray-300 shrink-0">
      <%= comment.user.name[0].upcase %>
    </div>
    <div class="flex-1">
      <p class="text-xs font-medium text-gray-700 dark:text-gray-200">
        <%= comment.user.name %>
        <span class="text-gray-400 dark:text-gray-500 font-normal"><%= comment.created_at.strftime("%d/%m %H:%M") %></span>
      </p>
      <p class="text-sm text-gray-600 dark:text-gray-300 mt-0.5"><%= comment.body %></p>

      <%# Anexos do comentário %>
      <% if comment.attachments.attached? %>
        <div class="mt-2 flex flex-wrap gap-2">
          <% comment.attachments.each do |attachment| %>
            <% if attachment.image? %>
              <%= link_to rails_blob_path(attachment, disposition: "inline"), target: "_blank", class: "block" do %>
                <%= image_tag attachment.variant(resize_to_limit: [100, 100]),
                      class: "w-12 h-12 object-cover rounded-md border hover:opacity-80 transition",
                      alt: attachment.filename %>
              <% end %>
            <% else %>
              <%= link_to rails_blob_path(attachment, disposition: "attachment"), target: "_blank",
                    class: "flex items-center gap-1 text-xs text-blue-600 hover:underline bg-gray-100 dark:bg-gray-800 rounded-md px-2 py-1" do %>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                </svg>
                <span><%= attachment.filename %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </li>
<% end %>
      </ul>
    <% end %>

    <%= form_with model: [@ticket, @comment], local: true, class: "flex flex-col gap-3" do |f| %>
      <%= f.text_area :body, placeholder: "Adicionar comentário...", rows: 2,
            class: "border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-sm resize-none bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500" %>

      <div>
        <%= f.label :attachments, "Anexos (opcional)", class: "block text-xs text-gray-500 dark:text-gray-400 mb-1" %>
        <%= f.file_field :attachments, multiple: true, direct_upload: true,
              class: "block w-full text-sm text-gray-500 dark:text-gray-400 file:mr-2 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 dark:file:bg-gray-700 dark:file:text-gray-300" %>
        <p class="mt-1 text-xs text-gray-400">Você pode enviar várias imagens ou arquivos.</p>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Enviar comentário", class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>

</div>