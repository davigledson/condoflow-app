<%# app/views/tickets/new.html.erb %>
<div class="max-w-lg mx-auto">
  <h1 class="text-xl font-semibold text-gray-800 mb-6">Novo Chamado</h1>

  <%= form_with model: @ticket, local: true do |f| %>
    <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">

      <div>
        <%= f.label :unit_id, "Unidade", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :unit_id,
              options_from_collection_for_select(@units, :id, :identifier, @ticket.unit_id),
              { include_blank: "Selecione a unidade" },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :ticket_type_id, "Tipo", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :ticket_type_id,
              options_from_collection_for_select(TicketType.all, :id, :title, @ticket.ticket_type_id),
              { include_blank: "Selecione o tipo" },
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :description, "Descrição", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :description, rows: 4,
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm resize-none" %>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <%= link_to "Cancelar", tickets_path, class: "text-sm text-gray-500 hover:underline self-center" %>
        <%= f.submit "Abrir Chamado", class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700 cursor-pointer" %>
      </div>

    </div>
  <% end %>
</div>