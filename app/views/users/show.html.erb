<%# app/views/users/show.html.erb %>
<div class="max-w-3xl mx-auto space-y-6">
  <!-- Dados principais -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-2"><%= @user.name %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= @user.email %></p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Perfil: <span class="font-medium capitalize"><%= @user.role %></span></p>
      </div>
      <%= link_to "Editar", edit_user_path(@user), class: "bg-gray-700 dark:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800 transition" %>
    </div>
  </div>

  <!-- Unidades (se morador) -->
  <% if @user.resident? && @user.units.any? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Unidades onde reside</h2>
      <div class="flex flex-wrap gap-2">
        <% @user.units.each do |unit| %>
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300">
            <%= unit.identifier %> (Bloco <%= unit.block.identifier %>)
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Chamados criados pelo usuário -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Chamados abertos (<%= @user.tickets.count %>)</h2>
    <% if @user.tickets.any? %>
      <ul class="divide-y divide-gray-100 dark:divide-gray-700">
        <% @user.tickets.order(created_at: :desc).limit(10).each do |ticket| %>
          <li class="py-3 flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= ticket.description.truncate(60) %></p>
              <p class="text-xs text-gray-500 dark:text-gray-400">
                Unidade <%= ticket.unit.identifier %> · <%= ticket.ticket_type.title %> · Aberto em <%= l(ticket.created_at, format: :short) %>
              </p>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 rounded-full text-xs font-medium
                <%= ticket.ticket_status.is_final ? 'bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300' : 'bg-yellow-100 dark:bg-yellow-900 text-yellow-700 dark:text-yellow-300' %>">
                <%= ticket.ticket_status.name %>
              </span>
              <%= link_to "Ver", ticket_path(ticket), class: "text-blue-500 dark:text-blue-400 hover:underline text-sm" %>
            </div>
          </li>
        <% end %>
      </ul>
      <% if @user.tickets.count > 10 %>
        <div class="mt-3 text-right">
          <%= link_to "Ver todos os chamados", tickets_path(user_id: @user.id), class: "text-xs text-gray-500 dark:text-gray-400 hover:underline" %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-400 dark:text-gray-500">Nenhum chamado aberto ainda.</p>
    <% end %>
  </div>

  <!-- Últimos comentários -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Últimos comentários</h2>
    <% if @user.comments.any? %>
      <ul class="space-y-3">
        <% @user.comments.order(created_at: :desc).limit(5).each do |comment| %>
          <li class="text-sm">
            <span class="text-gray-500 dark:text-gray-400">Em <%= l(comment.created_at, format: :short) %>, no chamado</span>
            <%= link_to "##{comment.ticket.id}", ticket_path(comment.ticket), class: "font-medium text-blue-600 dark:text-blue-400 hover:underline" %>:
            <span class="text-gray-700 dark:text-gray-300"><%= comment.body.truncate(80) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-400 dark:text-gray-500">Nenhum comentário feito.</p>
    <% end %>
  </div>

  <!-- Tipos atribuídos (colaboradores) -->
  <% if @user.collaborator? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Tipos de Chamado Atribuídos</h2>
      <% if @user.assigned_ticket_types.any? %>
        <div class="flex flex-wrap gap-2">
          <% @user.assigned_ticket_types.each do |tt| %>
            <span class="px-3 py-1 rounded-full text-xs font-medium bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300">
              <%= tt.title %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-400 dark:text-gray-500">Nenhum tipo atribuído ainda.</p>
      <% end %>
    </div>
  <% end %>
</div>