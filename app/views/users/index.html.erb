<%# app/views/users/index.html.erb %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-gray-800">Usuários</h1>
  <%= link_to "Novo Usuário", new_user_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700" %>
</div>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 text-left">
      <tr>
        <th class="px-4 py-3">Nome</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Papel</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @users.each do |user| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3 font-medium text-gray-700"><%= user.name %></td>
          <td class="px-4 py-3 text-gray-500"><%= user.email %></td>
          <td class="px-4 py-3">
            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
              <%= user.role %>
            </span>
          </td>
          <td class="px-4 py-3 flex gap-3">
            <%= link_to "Editar", edit_user_path(user), class: "text-blue-600 hover:underline" %>
            <%= button_to "Remover", user_path(user), method: :delete,
                  data: { confirm: "Tem certeza?" },
                  class: "text-red-500 hover:underline bg-transparent border-0 p-0 cursor-pointer text-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>