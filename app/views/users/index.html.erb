<%# app/views/users/index.html.erb %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-100">Usuários</h1>
  <%= link_to "Novo Usuário", new_user_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700" %>
</div>

<!-- WIDGETS (cards) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <!-- Card 1: Total de usuários -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Total de Usuários</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1"><%= @users.total_count %></p>
      </div>
      <div class="rounded-full bg-indigo-50 dark:bg-indigo-900/30 p-3 text-indigo-500 dark:text-indigo-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 2: Administradores -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Administradores</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1"><%= User.admin.count %></p>
      </div>
      <div class="rounded-full bg-red-50 dark:bg-red-900/30 p-3 text-red-500 dark:text-red-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 3: Colaboradores -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Colaboradores</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1"><%= User.collaborator.count %></p>
      </div>
      <div class="rounded-full bg-amber-50 dark:bg-amber-900/30 p-3 text-amber-500 dark:text-amber-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 4: Moradores -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Moradores</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1"><%= User.resident.count %></p>
      </div>
      <div class="rounded-full bg-green-50 dark:bg-green-900/30 p-3 text-green-500 dark:text-green-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- TABELA -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden mb-8">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 text-left">
      <tr>
        <th class="px-4 py-3">Nome</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Papel</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>

    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
      <% @users.each do |user| %>
        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
          <td class="px-4 py-3 font-medium text-gray-700 dark:text-gray-200">
            <%= user.name %>
          </td>
          <td class="px-4 py-3 text-gray-500 dark:text-gray-400">
            <%= user.email %>
          </td>
          <td class="px-4 py-3">
            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
              <%= user.role %>
            </span>
          </td>
          <td class="px-4 py-3 flex gap-3">
            <%= link_to "Ver", user_path(user), class: "text-blue-500 dark:text-blue-400 hover:underline" %>
            <%= link_to "Editar", edit_user_path(user), class: "text-gray-500 dark:text-gray-400 hover:underline" %>
            <%= button_to "Remover", user_path(user), method: :delete,
                  data: { confirm: "Tem certeza?" },
                  class: "text-red-500 dark:text-red-400 hover:underline bg-transparent border-0 p-0 cursor-pointer text-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>


<%= render "layouts/pagination", paginator: @users %>