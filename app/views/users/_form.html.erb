<%# app/views/users/_form.html.erb %>
<%= form_with model: user, local: true do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">

    <% if user.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm">
        <% user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      <% if user.persisted? %>
        <p class="text-xs text-gray-400 mt-1">Deixe em branco para manter a senha atual.</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirmar Senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= f.label :role, "Papel", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :role,
            User.roles.keys.map { |r| [r.capitalize, r] },
            {},
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div class="flex justify-end gap-3 pt-2">
      <%= link_to "Cancelar", users_path, class: "text-sm text-gray-500 hover:underline self-center" %>
      <%= f.submit user.persisted? ? "Salvar" : "Criar Usuário",
            class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700 cursor-pointer" %>
    </div>

  </div>
<% end %>