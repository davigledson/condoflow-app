<%# app/views/blocks/_form.html.erb %>
<%= form_with model: block, local: true do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">

    <% if block.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm">
        <% block.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :identifier, "Identificador (ex: A, B, C)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :identifier, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= f.label :floors_count, "Quantidade de andares", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :floors_count, min: 1, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= f.label :units_per_floor, "Apartamentos por andar", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :units_per_floor, min: 1, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <% if block.persisted? %>
      <p class="text-xs text-yellow-600 bg-yellow-50 border border-yellow-200 rounded-lg px-3 py-2">
        Editar um bloco não regenera as unidades existentes.
      </p>
    <% end %>

    <div class="flex justify-end gap-3 pt-2">
      <%= link_to "Cancelar", blocks_path, class: "text-sm text-gray-500 hover:underline self-center" %>
      <%= f.submit block.persisted? ? "Salvar" : "Criar Bloco",
            class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700 cursor-pointer" %>
    </div>

  </div>
<% end %>