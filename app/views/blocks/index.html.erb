<%# app/views/blocks/index.html.erb %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-gray-800">Blocos</h1>
  <%= link_to "Novo Bloco", new_block_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700" %>
</div>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 text-left">
      <tr>
        <th class="px-4 py-3">Identificador</th>
        <th class="px-4 py-3">Andares</th>
        <th class="px-4 py-3">Aptos por andar</th>
        <th class="px-4 py-3">Total de unidades</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @blocks.each do |block| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3 font-medium text-gray-700">Bloco <%= block.identifier %></td>
          <td class="px-4 py-3 text-gray-500"><%= block.floors_count %></td>
          <td class="px-4 py-3 text-gray-500"><%= block.units_per_floor %></td>
          <td class="px-4 py-3 text-gray-500"><%= block.units.count %></td>
          <td class="px-4 py-3 flex gap-3">
            <%= link_to "Ver unidades", block_path(block), class: "text-blue-600 hover:underline" %>
            <%= link_to "Editar", edit_block_path(block), class: "text-gray-500 hover:underline" %>
            <%= button_to "Remover", block_path(block), method: :delete,
                  data: { confirm: "Remover o bloco e todas as unidades?" },
                  class: "text-red-500 hover:underline bg-transparent border-0 p-0 cursor-pointer text-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>