<%# app/views/admin/audits/index.html.erb %>

<div class="max-w-6xl mx-auto">
  <!-- Cabeçalho -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-white flex items-center gap-2">
      <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      Auditoria Centralizada
    </h1>
    <div class="flex items-center gap-3">
      <span class="text-sm bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full text-gray-600 dark:text-gray-300">
        Últimos <%= @events.count %> eventos
      </span>
      <%= link_to "Limpar filtros", admin_auditoria_path, class: "text-sm text-blue-600 dark:text-blue-400 hover:underline" %>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6 shadow-sm">
    <div class="flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-[150px]">
        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Tipo de evento</label>
        <select id="eventTypeFilter" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-gray-900">
          <option value="all">Todos</option>
          <option value="ticket_created">Novos chamados</option>
          <option value="status_change">Mudanças de status</option>
          <option value="comment">Comentários</option>
        </select>
      </div>
      <div class="flex-1 min-w-[150px]">
        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Usuário</label>
        <select id="userFilter" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-gray-900">
          <option value="all">Todos</option>
          <% User.order(:name).each do |user| %>
            <option value="<%= user.id %>"><%= user.name %></option>
          <% end %>
        </select>
      </div>
      <button id="applyFilters" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm transition">
        Aplicar
      </button>
    </div>
  </div>

  <!-- Timeline -->
  <div class="space-y-4">
    <% @events.each do |event| %>
      <div class="group bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm hover:shadow-lg transition-all duration-200"
           data-event-type="<%= event[:type] %>"
           data-user-id="<%= event[:user]&.id %>">
        <div class="flex flex-col sm:flex-row sm:items-start gap-4">
          <!-- Ícone com cores condicionais usando lógica Ruby -->
          <div class="flex-shrink-0">
            <div class="w-12 h-12 rounded-full flex items-center justify-center
                        <%= case event[:type]
                            when :ticket_created then 'bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-400'
                            when :status_change then 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-400'
                            when :comment then 'bg-purple-100 dark:bg-purple-900 text-purple-600 dark:text-purple-400'
                            end %>">
              <%= case event[:type]
                  when :ticket_created then
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>'.html_safe
                  when :status_change then
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>'.html_safe
                  when :comment then
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>'.html_safe
                  end %>
            </div>
          </div>

          <!-- Conteúdo -->
          <div class="flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-gray-800 dark:text-gray-100"><%= event[:user]&.name || "Sistema" %></span>
                <span class="text-gray-500 dark:text-gray-400 text-sm">
                  <% case event[:type] %>
                  <% when :ticket_created %>
                    criou o chamado
                  <% when :status_change %>
                    alterou o status para
                    <span class="font-medium text-gray-700 dark:text-gray-300"><%= event[:detail] %></span>
                  <% when :comment %>
                    comentou no chamado
                  <% end %>
                </span>
              </div>
              <span class="text-xs text-gray-400 dark:text-gray-500"><%= time_ago_in_words(event[:at]) %> atrás</span>
            </div>

            <div class="mt-2">
              <%= link_to "##{event[:ticket].id} - #{event[:ticket].description.truncate(80)}", ticket_path(event[:ticket]), class: "text-sm text-blue-600 dark:text-blue-400 hover:underline font-medium" %>
            </div>

            <% if event[:type] == :comment %>
              <div class="mt-3 text-sm text-gray-600 dark:text-gray-300 bg-gray-50 dark:bg-gray-700/30 rounded-lg p-3 italic border-l-4 border-purple-300 dark:border-purple-700">
                “<%= event[:detail] %>”
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @events.empty? %>
    <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
      <svg class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <p class="text-gray-500 dark:text-gray-400">Nenhum evento registrado ainda.</p>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const typeSelect = document.getElementById('eventTypeFilter');
    const userSelect = document.getElementById('userFilter');
    const applyBtn = document.getElementById('applyFilters');

    function filterEvents() {
      const selectedType = typeSelect.value;
      const selectedUserId = userSelect.value;
      const events = document.querySelectorAll('[data-event-type]');

      events.forEach(event => {
        const eventType = event.getAttribute('data-event-type');
        const eventUserId = event.getAttribute('data-user-id');
        let show = true;

        if (selectedType !== 'all' && eventType !== selectedType) show = false;
        if (selectedUserId !== 'all' && eventUserId !== selectedUserId) show = false;

        event.style.display = show ? '' : 'none';
      });
    }

    applyBtn.addEventListener('click', filterEvents);
  });
</script>