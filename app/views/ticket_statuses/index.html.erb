<%# app/views/ticket_statuses/index.html.erb %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-100">Status de Chamado</h1>
  <%= link_to "Novo Status", new_ticket_status_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700" %>
</div>

<!-- WIDGETS / CARDS -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <!-- Card 1: Total de status -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Total de Status</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1"><%= @ticket_statuses.total_count %></p>
      </div>
      <div class="rounded-full bg-indigo-50 dark:bg-indigo-900/30 p-3 text-indigo-500 dark:text-indigo-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 2: Status padrão -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Status Padrão</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1">
          <%= @ticket_statuses.select(&:is_default).count %>
        </p>
      </div>
      <div class="rounded-full bg-blue-50 dark:bg-blue-900/30 p-3 text-blue-500 dark:text-blue-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 3: Status final -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Status Final</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1">
          <%= @ticket_statuses.select(&:is_final).count %>
        </p>
      </div>
      <div class="rounded-full bg-green-50 dark:bg-green-900/30 p-3 text-green-500 dark:text-green-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 4: Status normais (nem padrão nem final) -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Status Normais</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1">
          <%= @ticket_statuses.reject { |s| s.is_default || s.is_final }.count %>
        </p>
      </div>
      <div class="rounded-full bg-amber-50 dark:bg-amber-900/30 p-3 text-amber-500 dark:text-amber-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- TABELA (original) -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 text-left">
      <tr>
        <th class="px-4 py-3">Nome</th>
        <th class="px-4 py-3">Padrão</th>
        <th class="px-4 py-3">Final</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
      <% @ticket_statuses.each do |status| %>
        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
          <td class="px-4 py-3 font-medium text-gray-700 dark:text-gray-200"><%= status.name %></td>
          <td class="px-4 py-3">
            <% if status.is_default %>
              <span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded-full">sim</span>
            <% else %>
              <span class="text-xs text-gray-300 dark:text-gray-600">não</span>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <% if status.is_final %>
              <span class="bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded-full">sim</span>
            <% else %>
              <span class="text-xs text-gray-300 dark:text-gray-600">não</span>
            <% end %>
          </td>
          <td class="px-4 py-3 flex gap-3">
            <%= link_to "Editar", edit_ticket_status_path(status), class: "text-blue-500 dark:text-blue-400 hover:underline" %>
            <%= button_to "Remover", ticket_status_path(status), method: :delete,
                  data: { confirm: "Tem certeza?" },
                  class: "text-red-500 dark:text-red-400 hover:underline bg-transparent border-0 p-0 cursor-pointer text-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "layouts/pagination", paginator: @ticket_statuses %>