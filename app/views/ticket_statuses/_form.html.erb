<%# app/views/ticket_statuses/_form.html.erb %>
<%= form_with model: ticket_status, local: true do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">

    <% if ticket_status.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm">
        <% ticket_status.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div class="flex gap-6">
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <%= f.check_box :is_default, class: "rounded border-gray-300" %>
        Status padrão ao abrir chamado
      </label>

      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <%= f.check_box :is_final, class: "rounded border-gray-300" %>
        Status final (encerra o chamado)
      </label>
    </div>

    <div class="flex justify-end gap-3 pt-2">
      <%= link_to "Cancelar", ticket_statuses_path, class: "text-sm text-gray-500 hover:underline self-center" %>
      <%= f.submit ticket_status.persisted? ? "Salvar" : "Criar",
            class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700 cursor-pointer" %>
    </div>

  </div>
<% end %>