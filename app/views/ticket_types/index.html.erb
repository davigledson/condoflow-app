<%# app/views/ticket_types/index.html.erb %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-100">Tipos de Chamado</h1>
  <%= link_to "Novo Tipo", new_ticket_type_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700" %>
</div>



<!-- TABELA (original) -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden mb-8">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 text-left">
      <tr>
        <th class="px-4 py-3">Título</th>
        <th class="px-4 py-3">SLA (horas)</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
      <% @ticket_types.each do |type| %>
        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
          <td class="px-4 py-3 font-medium text-gray-700 dark:text-gray-200"><%= type.title %></td>
          <td class="px-4 py-3 text-gray-500 dark:text-gray-400"><%= type.sla_hours %>h</td>
          <td class="px-4 py-3 flex gap-3">
            <%= link_to "Editar", edit_ticket_type_path(type), class: "text-blue-600 hover:underline" %>
            <%= button_to "Remover", ticket_type_path(type), method: :delete,
                  data: { confirm: "Tem certeza?" },
                  class: "text-red-500 hover:underline bg-transparent border-0 p-0 cursor-pointer text-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>


<!-- WIDGETS / CARDS -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-12">
  <!-- Card 1: Total de tipos -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Total de Tipos</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1"><%= @ticket_types.total_count %></p>
      </div>
      <div class="rounded-full bg-blue-50 dark:bg-blue-900/30 p-3 text-blue-500 dark:text-blue-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 2: Média de SLA -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Média SLA</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1">
          <%= @ticket_types.total_count > 0 ? (@ticket_types.sum(:sla_hours).to_f / @ticket_types.total_count).round(1) : 0 %>h
        </p>
      </div>
      <div class="rounded-full bg-green-50 dark:bg-green-900/30 p-3 text-green-500 dark:text-green-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 3: Maior SLA -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Maior SLA</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1">
          <% max_sla = @ticket_types.maximum(:sla_hours) %>
          <%= max_sla ? "#{max_sla}h" : "-" %>
        </p>
      </div>
      <div class="rounded-full bg-red-50 dark:bg-red-900/30 p-3 text-red-500 dark:text-red-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Card 4: Menor SLA -->
  <div class="group bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Menor SLA</p>
        <p class="text-3xl font-extrabold text-gray-800 dark:text-white mt-1">
          <% min_sla = @ticket_types.minimum(:sla_hours) %>
          <%= min_sla ? "#{min_sla}h" : "-" %>
        </p>
      </div>
      <div class="rounded-full bg-amber-50 dark:bg-amber-900/30 p-3 text-amber-500 dark:text-amber-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
    </div>
  </div>
</div>
<%= render "layouts/pagination", paginator: @ticket_types %>