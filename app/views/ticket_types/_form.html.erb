<%# app/views/ticket_types/_form.html.erb %>
<%= form_with model: ticket_type, local: true do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">

    <% if ticket_type.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm">
        <% ticket_type.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "Título", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= f.label :sla_hours, "Prazo máximo de resolução (horas)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :sla_hours, min: 1, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>

    <div class="flex justify-end gap-3 pt-2">
      <%= link_to "Cancelar", ticket_types_path, class: "text-sm text-gray-500 hover:underline self-center" %>
      <%= f.submit ticket_type.persisted? ? "Salvar" : "Criar",
            class: "bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700 cursor-pointer" %>
    </div>

  </div>
<% end %>